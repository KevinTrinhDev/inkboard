{
  "name": "inkboard",
  "private": true,
  "version": "0.1.0",
  "description": "Semantic-first teaching board: draw on an iPad, record a facecam, never bake handwriting into video.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "dev:server": "pnpm --filter @inkboard/server dev",
    "dev:client": "pnpm --filter @inkboard/client dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
