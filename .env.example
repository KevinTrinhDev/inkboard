# Copy to .env and fill in real values. Never commit .env.
# See docs/SECURITY.md for how these are used.

# Port the Fastify server listens on (Caddy reverse-proxies to this)
SERVER_PORT=8080

# Secret used to sign/verify device-pairing tokens. Generate with:
#   openssl rand -hex 32
PAIRING_TOKEN_SECRET=replace-me-with-a-random-64-char-hex-string

# Local HTTP address of the faster-whisper sidecar (M2, not wired up yet)
WHISPER_SIDECAR_URL=http://127.0.0.1:8090

# Where uploaded recordings are written on the XPS (gitignored)
RECORDINGS_DIR=./apps/server/recordings

# The mDNS/LAN hostname Caddy issues its local-CA cert for
CADDY_DOMAIN=inkboard.local

# OPTIONAL — removes the tldraw "made with tldraw" watermark (trial/
# commercial key from tldraw.dev). Without a key, free non-commercial use
# shows the watermark; the app works fine either way.
# VITE_TLDRAW_LICENSE_KEY=
