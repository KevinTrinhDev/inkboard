# Local-only reverse proxy for inkboard. Uses Caddy's built-in local CA
# (`tls internal`) so the iPad gets a secure context (required for
# getUserMedia) without a public domain or Let's Encrypt. See
# infra/caddy/README.md and docs/SECURITY.md for the trust flow.
#
# {$CADDY_DOMAIN} defaults to inkboard.local (set in .env / exported before
# running Caddy). Requires mDNS (Avahi, ships with Ubuntu) to resolve on the
# LAN, or a static /etc/hosts entry on client devices that don't support it.

# Caddy names every local CA "Caddy Local Authority - <year> ECC Root" by
# default. Anyone who has run another Caddy project already has a profile by
# that exact name on their iPad, with a different key, so the two are
# indistinguishable in Settings while only one of them validates this server.
# Naming the CA after the project makes it obvious which profile belongs to
# inkboard, and safe to remove later.
{
	pki {
		ca local {
			name "inkboard"
			root_cn "inkboard Local CA"
			intermediate_cn "inkboard Local CA - Intermediate"
		}
	}
}

# Both names are served. The .local name is the one everything points at,
# but it depends on mDNS, and when that is unavailable the docs tell the
# operator to "use the LAN IP instead" - which used to fail the TLS handshake
# outright, because this block matched only the host name and the automation
# policy issued a cert only for it. Listing the IP as a second site subject
# makes the documented fallback real: Caddy's internal issuer mints a cert
# with the IP in a SAN.
{$CADDY_DOMAIN:inkboard.local}, {$CADDY_LAN_IP:127.0.0.1} {
	tls internal

	# TEMPORARY: serves the local CA cert itself over the already-firewalled
	# 443 port, so it can be downloaded on the iPad without opening any new
	# port. Remove this block once the cert has been trusted on-device.
	handle /inkboard-ca.crt {
		root * {$REPO_ROOT}
		# The file on disk is PEM, but Caddy sniffs .crt as
		# application/pkix-cert, which denotes DER. iOS is picky about this on
		# the "Profile Downloaded" path: with the wrong type Safari may drop
		# the file into Files instead of offering to install a profile, which
		# silently breaks the very first step of iPad setup.
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:{$SERVER_PORT:8080}
	}

	# Firm ceiling; recordings are uploaded once on stop (M0), not streamed.
	request_body {
		max_size 2GB
	}
}
